{
  "mcpServers": {
    "connect": {
      "command": "${ComSpec:-/bin/sh}",
      "args": ["-c", "set -f;IFS=;exec sh $1", "/c", "${CLAUDE_PLUGIN_ROOT}/mcp/launcher.bat"],
      "env": {
        "CONNECT_HOME": "${CONNECT_HOME}",
        "CONNECT_VAULT_MATRIZ": "${CONNECT_VAULT_MATRIZ}",
        "CONNECT_CEREBRO_PESSOAL": "${CONNECT_CEREBRO_PESSOAL}"
      }
    }
  }
}
