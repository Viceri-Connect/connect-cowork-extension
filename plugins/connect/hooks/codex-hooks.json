{
  "description": "Restore Connect context when a Codex session starts or resumes, and mark scans inside Connect vaults (hard rule 4). Runs on the same portable Node runtime as Cowork (scripts/run-node.*), so Node on PATH is not required.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/session-start-codex.mjs\"",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\run-node.bat\" \"${PLUGIN_ROOT}\\hooks\\session-start-codex.mjs\"",
            "statusMessage": "Loading Connect session context",
            "timeout": 120,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT}/hooks/guarda-varredura.mjs\" codex",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\run-node.bat\" \"${PLUGIN_ROOT}\\hooks\\guarda-varredura.mjs\" codex",
            "statusMessage": "Connect: checking vault scans",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
