#!/bin/sh
# connect-mcp - entrada do servidor MCP para os hosts do formato portavel
# (Codex e Copilot via mcp.json; Antigravity via mcp_config.json). macOS/Linux.
#
# 0.41.0 - ate aqui esses hosts chamavam `node` direto: em maquina sem Node no PATH o
# MCP nao subia. Agora passam pelo MESMO runtime do Cowork (scripts/run-node.sh: Node
# portatil em $CONNECT_HOME/bin, baixado na 1a vez; em sandbox sem escrita no
# CONNECT_HOME, na pasta de dados do host). O Windows usa o irmao connect-mcp.cmd: o
# host resolve a extensao pelo PATHEXT, como faz com `npx`.
#
# Precisa de modo 755 no git (o host executa este arquivo direto, sem shell).
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec /bin/sh "$DIR/run-node.sh" "$DIR/../mcp/connect-mcp.mjs" "$@"
