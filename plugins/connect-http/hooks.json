{
  "connect-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./hooks/session-start-antigravity.mjs",
        "timeout": 120
      },
      {
        "type": "command",
        "command": "/bin/sh ./scripts/run-node.sh ./hooks/session-start-antigravity.mjs",
        "timeout": 120
      }
    ]
  },
  "connect-varredura": {
    "PreToolUse": [
      {
        "matcher": "grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/run-node.ps1 ./hooks/guarda-varredura.mjs antigravity",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/bin/sh ./scripts/run-node.sh ./hooks/guarda-varredura.mjs antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
